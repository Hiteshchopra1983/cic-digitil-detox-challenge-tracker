# Copy to backend/.env for a fully local API + database.
# Do not commit backend/.env

PORT=3000
JWT_SECRET=local-dev-jwt-secret-change-me
FRONTEND_URL=http://localhost:8080

# Local Postgres (start Windows service postgresql-x64-18 first)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=YOUR_LOCAL_POSTGRES_PASSWORD
PGDATABASE=detox

# Or point at RDS instead of local Postgres:
# DATABASE_URL=postgresql://USER:PASS@detox.cn04gwqoou9q.eu-west-3.rds.amazonaws.com:5432/detox?sslmode=require
# PGSSLMODE=require
